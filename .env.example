# Anthropic Claude API key (required)
ANTHROPIC_API_KEY=

# Optional: override the model (defaults to claude-opus-5)
# CLAUDE_MODEL=claude-opus-5

# Only required if your API key is a multi-workspace personal/service-account key
# (Console will return: "anthropic-workspace-id is required..."). Find the ID at
# Settings > Workspaces in the Claude Console, or create a workspace-scoped key
# instead to avoid needing this.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
